# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=janice
POSTGRES_USER=janice
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

REDCAP_API_URL=
REDCAP_TOKEN_NEONATAL=
REDCAP_TOKEN_PAEDIATRICS=
REDCAP_TOKEN_MATERNITY=
# REDCap server's time zone (Control Center -> "REDCap server's current time")
REDCAP_SERVER_TIMEZONE=UTC

# Pipeline: "synthetic" on laptops and CI; "redcap" only on staging/production
JANICE_SOURCE=synthetic
# Data dictionaries and the staging file (default ~/janice-data, outside the repo)
JANICE_DATA_DIR=
# HMAC key for identifier hashing: 64 hex characters, from secrets.token_hex(32)
JANICE_HASH_KEY=

DAGSTER_HOME=/home/bob/janice-data/dagster-home
